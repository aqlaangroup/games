      m_Items: []
  - m_Id: 48782543675399
    m_Localized: "\u062E\u0627\u0644\u062A\u0648: \u0627\u0644\u062E\u0627\u0644\u0629\u060C
      \u0648\u062A\u0642\u0627\u0644 \u0644\u0643\u0644 \u0642\u0631\u064A\u0628\u0629
