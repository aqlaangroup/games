    m_Localized: "\u0627\u0644\u0645\u0631\u064A\u0645\u064A\u0629\u060C \u0639\u0634\u0628\u0629
      \u064A\u064F\u0639\u0637\u064E\u0651\u0631 \u0628\u0647\u0627 \u0627\u0644\u0634\u0627\u064A
