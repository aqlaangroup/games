    m_Localized: "\u0623\u0645\u0651\u064A \u062A\u0633\u0648\u0651\u064A \u0643\u0630\u0627
      \u0628\u0627\u0644\u0636\u0628\u0637. \u0639\u0645\u0631\u0647\u0627 \u0645\u0627
