  - m_Id: 399969738547283
    m_Localized: "\u062A\u0633\u0644\u0645 \u0625\u064A\u062F\u0643! \u0645\u0646
      \u0632\u0645\u0627\u0646 \u0645\u0627 \u0630\u0642\u062A \u0625\u0634\u064A
      \u0647\u064A\u0643."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547284
    m_Localized: "\u064A\u0639\u0637\u064A\u0643\u0650 \u0627\u0644\u0639\u0627\u0641\u064A\u0629.
      \u0627\u0644\u0645\u0631\u0651\u0629 \u0627\u0644\u062C\u0627\u064A\u0629 \u0628\u062C\u064A\u0628
      \u0623\u0647\u0644\u064A."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547285
    m_Localized: "\u0648\u0627\u0644\u0644\u0647 \u0631\u062C\u0651\u0639\u062A\u064A\u0646\u064A
      \u0644\u0623\u064A\u0627\u0645 \u0632\u0645\u0627\u0646."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547286
    m_Localized: "\u0647\u064A\u0643 \u0628\u062A\u0643\u0645\u0644 \u0627\u0644\u0642\u0639\u062F\u0629.
      \u0627\u0644\u0644\u0647 \u064A\u0633\u0639\u062F\u0643."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547287
    m_Localized: "\u0637\u064A\u0651\u0628 \u0643\u062A\u064A\u0631! \u0627\u0644\u062D\u0627\u0631\u0629
      \u0643\u0627\u0646\u062A \u0646\u0627\u0642\u0635\u0647\u0627 \u0647\u0627\u0644\u0642\u0647\u0648\u0629."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547288
    m_Localized: "\u0634\u0643\u0631\u064B\u0627. \u0623\u0648\u0644 \u0645\u0631\u0629
      \u0628\u062D\u0633 \u0625\u0646\u0651\u064A \u0645\u0634 \u0644\u062D\u0627\u0644\u064A
      \u0628\u0647\u0627\u0644\u0645\u062F\u064A\u0646\u0629."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547289
    m_Localized: "\u0627\u0644\u062D\u0628\u0651\u0629 \u0627\u0644\u062E\u0636\u0631\u0627
      \u0644\u0633\u0651\u0627 \u0645\u0627 \u0625\u0644\u0647\u0627 \u0631\u064A\u062D\u0629.
      \u0643\u0644 \u0625\u0634\u064A \u062D\u0644\u0648 \u0628\u064A\u0628\u0644\u0651\u0634
      \u0647\u064A\u0643."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547290
    m_Localized: "\u0623\u0648\u0644 \u062A\u062D\u0645\u064A\u0635\u0629\u060C \u0633\u0646\u0629
      74\u060C \u0627\u062D\u062A\u0631\u0642 \u0646\u0635\u0651\u0647\u0627. \u0645\u0627
      \u062D\u062F\u0627 \u0639\u0631\u0641\u2026 \u0625\u0644\u0627 \u0623\u0645
      \u0633\u0645\u064A\u0631\u0629."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547291
    m_Localized: "\u062D\u0641\u0646\u0629 \u0644\u0643\u0644 \u0636\u064A\u0641\u060C
      \u0648\u062D\u0641\u0646\u0629 \u0632\u064A\u0627\u062F\u0629. \u0627\u0644\u0636\u064A\u0641
      \u0627\u0644\u062A\u0627\u0646\u064A \u062F\u0627\u064A\u0645\u064B\u0627 \u062C\u0627\u064A."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547292
    m_Localized: "\u0627\u0644\u0637\u062D\u0646\u0629 \u0646\u0627\u0639\u0645\u0629
      \u0645\u062A\u0644 \u0627\u0644\u0637\u062D\u064A\u0646. \u0623\u0628\u0648
      \u0641\u0627\u062F\u064A \u0628\u064A\u0639\u0631\u0641 \u0645\u0646 \u0623\u0648\u0644
      \u0634\u0641\u0651\u0629."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547293
    m_Localized: "\u0627\u0644\u0647\u064A\u0644 \u0622\u062E\u0631 \u0625\u0634\u064A\u060C
      \u0648\u0631\u064A\u062D\u062A\u0647 \u0628\u062A\u0633\u0628\u0642\u0647.
      \u0645\u062A\u0644 \u062D\u0628\u0651\u0629 \u0627\u0644\u0647\u064A\u0644
      \u062A\u0628\u0639\u062A\u064A."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547294
    m_Localized: "\u0623\u0648\u0644 \u0641\u0646\u062C\u0627\u0646\u060C \u0633\u0646\u0629
      74\u060C \u0644\u0623\u0633\u062A\u0627\u0630 \u0641\u0627\u062F\u064A. \u0648\u0637\u0644\u0628
      \u0627\u0628\u062A\u0633\u0627\u0645\u0629\u060C \u0627\u0644\u0644\u0647 \u064A\u0633\u0627\u0645\u062D\u0647."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547295
    m_Localized: "\u0627\u0644\u062F\u0644\u0651\u0629 \u0627\u0644\u0635\u063A\u064A\u0631\u0629
      \u0625\u0644\u064A \u0644\u062D\u0627\u0644\u064A. \u0625\u0644\u0627 \u0644\u0628\u0646\u062A\u064A\u0646
      \u0632\u063A\u0627\u0631\u060C \u0648\u0625\u064A\u062F\u064A \u0641\u0648\u0642
      \u0625\u064A\u062F\u064A\u0647\u0645."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547296
    m_Localized: "\u062F\u0644\u0651\u062A\u064A \u0627\u0644\u0646\u062D\u0627\u0633:
      \u0637\u0644\u0628 \u0639\u0634\u0631\u0629\u060C \u062F\u0641\u0639\u062A
      \u0623\u0631\u0628\u0639\u0629. \u0623\u0628\u0648 \u0641\u0627\u062F\u064A
      \u0628\u064A\u0642\u0648\u0644 \u0633\u062A\u0651\u0629. \u063A\u0644\u0637\u0627\u0646."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547297
    m_Localized: "\u0627\u0644\u0635\u064A\u0646\u064A\u0629 \u0628\u0627\u0644\u0625\u064A\u062F\u064A\u0646
      \u0627\u0644\u062A\u0646\u062A\u064A\u0646\u060C \u0648\u0628\u062A\u0646\u0632\u0644
      \u0642\u062F\u0651\u0627\u0645 \u0627\u0644\u0643\u0628\u064A\u0631 \u0623\u0648\u0644."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547298
    m_Localized: "\u0627\u0644\u0636\u064A\u0627\u0641\u0629: \u0642\u0647\u0648\u0629\u060C
      \u0648\u062D\u0644\u0648\u060C \u0648\u0648\u062C\u0647 \u0628\u0634\u0648\u0634.
      \u0648\u0627\u0644\u0648\u062C\u0647 \u0623\u0647\u0645 \u0625\u0634\u064A."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547299
    m_Localized: "\u0648\u0635\u0644\u062A\u064A \u0644\u0647\u0648\u0646 \u064A\u0627
      \u0631\u0648\u062D\u064A\u061F \u0627\u0644\u0642\u0647\u0648\u0629 \u0635\u0627\u0631\u062A
      \u0625\u0644\u0643\u060C \u0648\u0627\u0633\u0645\u0647\u0627 \u0628\u064A\u0633\u062A\u0646\u0651\u0649
      \u0648\u0644\u0627\u062F\u064A."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547300
    m_Localized: "\u0627\u0644\u062E\u0634\u0646 \u0644\u0644\u0645\u0639\u0645\u0648\u0644\u060C
      \u0648\u0627\u0644\u0646\u0627\u0639\u0645 \u0644\u0644\u0628\u0633\u0628\u0648\u0633\u0629.
      \u0648\u0627\u0644\u0644\u064A \u0628\u064A\u062E\u0644\u0637\u0647\u0645\u060C
      \u0628\u064A\u062A\u0639\u0644\u0651\u0645."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547301
    m_Localized: "\u0627\u0644\u0637\u062D\u064A\u0646 \u0628\u064A\u0644\u0632\u0642
      \u0628\u0643\u0644 \u0625\u0634\u064A: \u0628\u0627\u0644\u0625\u064A\u062F\u064A\u0646\u060C
      \u0648\u0628\u0627\u0644\u0634\u0639\u0631\u060C \u0648\u0628\u0627\u0644\u0628\u0646\u0627\u062A.
      \u0623\u062D\u0644\u0649 \u0625\u0634\u064A."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547302
    m_Localized: "\u0627\u0644\u0639\u062C\u064A\u0646\u0629 \u0628\u062F\u0647\u0627
      \u062A\u0631\u062A\u0627\u062D \u0633\u0627\u0639\u0629. \u0645\u062A\u0644\u0646\u0627:
      \u0625\u0630\u0627 \u062A\u0639\u0628\u062A\u060C \u0628\u062A\u0642\u0633\u0649."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547303
    m_Localized: "\u0643\u0644 \u0643\u0631\u0629 \u0642\u062F\u0651 \u0627\u0644\u062C\u0648\u0632\u0629.
      \u0648\u0633\u0645\u064A\u0631\u0629 \u0643\u0627\u0646\u062A \u062A\u0627\u0643\u0644
      \u0648\u062D\u062F\u0629 \u0645\u0646 \u0643\u0644 \u062A\u0644\u0627\u062A\u0629."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547304
    m_Localized: "\u0627\u0644\u0645\u062F\u0648\u0651\u0631 \u0644\u0644\u062A\u0645\u0631\u060C
      \u0648\u0627\u0644\u0637\u0648\u064A\u0644 \u0644\u0644\u062C\u0648\u0632\u060C
      \u0648\u0623\u0628\u0648 \u0642\u0628\u0651\u0629 \u0644\u0644\u0641\u0633\u062A\u0642.
      \u0645\u0627 \u062A\u063A\u0644\u0637\u064A."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547305
    m_Localized: "\u0627\u0644\u0635\u062D\u0646 \u0644\u0644\u062C\u064A\u0631\u0627\u0646
      \u0642\u0628\u0644 \u0645\u0627 \u064A\u0643\u0648\u0646 \u0625\u0644\u0646\u0627.
      \u0627\u0644\u0644\u064A \u0628\u064A\u0639\u0637\u064A \u0623\u0648\u0644\u060C
      \u0628\u064A\u0627\u0643\u0644 \u0623\u0637\u064A\u0628."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547306
    m_Localized: "\u0639\u0644\u0628\u0629 \u0627\u0644\u0645\u0639\u0645\u0648\u0644
      \u0628\u062A\u0633\u0627\u0641\u0631. \u062D\u0637\u0651\u064A \u0641\u064A\u0647\u0627
      \u062D\u0628\u0651\u0629 \u0632\u064A\u0627\u062F\u0629\u060C \u0644\u0644\u0637\u0631\u064A\u0642."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547307
    m_Localized: "\u0627\u0644\u0642\u0637\u0639\u0629 \u0627\u0644\u0644\u064A \u0639\u0627\u0644\u0637\u0631\u0641
      \u0644\u0644\u0634\u0627\u0637\u0631\u064A\u0646 \u0628\u0633. \u0628\u0642\u0644\u0651\u0647\u0645
      \u0647\u064A\u0643\u060C \u0648\u0628\u064A\u0635\u064A\u0631\u0648\u0627 \u0634\u0627\u0637\u0631\u064A\u0646."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547308
    m_Localized: "\u0627\u0644\u0635\u062F\u0631 \u0628\u064A\u0644\u0641\u0651 \u0639\u0627\u0644\u0646\u0627\u0631
      \u0645\u062A\u0644 \u0627\u0644\u062F\u0646\u064A\u0627. \u0648\u0627\u0644\u0648\u0635\u0641\u0629\u061F
      \u0628\u0645\u0637\u0631\u062D \u0623\u0623\u0645\u0646 \u0645\u0646 \u0647\u0648\u0646."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547309
    m_Localized: "\u0635\u064A\u0646\u064A\u0629 \u0627\u0644\u0639\u064A\u062F \u0628\u062F\u0647\u0627
      \u0625\u064A\u062F\u064A\u0646 \u0643\u062A\u064A\u0631: \u062C\u0627\u0631\u0627\u062A\u060C
      \u0648\u0628\u0646\u0627\u062A\u060C \u0648\u062D\u062F\u0627 \u064A\u0633\u0631\u0642
      \u0627\u0644\u062C\u0648\u0632."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547310
    m_Localized: "\u0625\u0630\u0627 \u0648\u0635\u0644\u062A\u064A \u0644\u0647\u0648\u0646\u060C
      \u0635\u0627\u0631 \u0627\u0644\u062D\u0644\u0648 \u0628\u0625\u064A\u062F\u0643.
      \u0628\u0633 \u0623\u062D\u0644\u0649 \u0625\u0634\u064A\u061F \u0644\u0645\u0651\u0629
      \u0627\u0644\u0639\u064A\u062F."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547311
    m_Localized: "\u0646\u0639\u0646\u0639 \u0628\u0627\u0644\u0635\u064A\u0641\u060C
      \u0648\u0645\u064A\u0631\u0645\u064A\u0629 \u0628\u0627\u0644\u0634\u062A\u0627.
      \u0648\u0627\u0644\u0644\u064A \u0628\u064A\u062A\u062E\u0627\u0646\u0642 \u0639\u0644\u064A\u0647\u0645\u060C
      \u0645\u0627 \u0628\u064A\u0634\u0631\u0628."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547312
    m_Localized: "\u0627\u0644\u0646\u0639\u0646\u0639 \u0628\u0643\u0627\u0633\u0629
      \u0645\u064A \u0645\u062A\u0644 \u0627\u0644\u0648\u0631\u062F\u060C \u0628\u064A\u0636\u0644
      \u0637\u0627\u0632\u0629 \u0623\u0633\u0628\u0648\u0639."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547313
    m_Localized: "\u0627\u0644\u0634\u0627\u064A \u0627\u0644\u0646\u0627\u0634\u0641
      \u0628\u062F\u0651\u0647 \u0639\u0644\u0628\u0629 \u0645\u0633\u0643\u0651\u0631\u0629.
      \u0627\u0644\u0631\u064A\u062D\u0629 \u0625\u0630\u0627 \u0637\u0644\u0639\u062A\u060C
      \u0645\u0627 \u0628\u062A\u0631\u062C\u0639."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547314
    m_Localized: "\u0643\u0627\u0633\u0629 \u0634\u0627\u064A \u0648\u0642\u0639\u062F\u0629
      \u0639\u0627\u0644\u0639\u062A\u0628\u0629: \u0647\u064A\u0643 \u0643\u0627\u0646\u062A
      \u062A\u062E\u0644\u0635 \u0643\u0644 \u0632\u0639\u0644\u0629 \u0628\u0627\u0644\u062D\u0627\u0631\u0629."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547315
    m_Localized: "\u0627\u0644\u0634\u0627\u064A \u0628\u062F\u0651\u0647 \u064A\u062A\u062E\u062F\u0651\u0631
      \u0628\u0634\u0648\u064A\u0634. \u0627\u0644\u0644\u064A \u0628\u064A\u0633\u062A\u0639\u062C\u0644\u060C
      \u0628\u064A\u0634\u0631\u0628\u0647 \u0645\u0631\u0651."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547316
    m_Localized: "\u0627\u0644\u0646\u0639\u0646\u0639 \u0644\u0646\u0648\u0627\u0644\u060C
      \u0648\u0627\u0644\u0645\u064A\u0631\u0645\u064A\u0629 \u0644\u0631\u0646\u0627.
      \u0648\u0623\u0646\u0627 \u0628\u0634\u0631\u0628 \u0645\u0646 \u0627\u0644\u0625\u0628\u0631\u064A\u0642\u064A\u0646."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547317
    m_Localized: "\u0635\u064A\u0646\u064A\u0629 \u0627\u0644\u0634\u0627\u064A \u0628\u062A\u0644\u0645\u0651
      \u0627\u0644\u0632\u0639\u0644\u0627\u0646\u064A\u0646. \u0643\u0627\u0633\u0629
      \u0628\u0625\u064A\u062F \u0643\u0644 \u0648\u0627\u062D\u062F\u060C \u0648\u0627\u0644\u062D\u0643\u064A
      \u0628\u064A\u0645\u0634\u064A."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547318
    m_Localized: "\u0642\u0639\u062F\u0629 \u0627\u0644\u0639\u0635\u0631 \u0639\u0627\u0644\u0639\u062A\u0628\u0629
      \u0645\u0639 \u0627\u0644\u062C\u0627\u0631\u0627\u062A. \u0647\u0646\u0627\u0643
      \u0628\u062A\u0646\u062D\u0644\u0651 \u0645\u0634\u0627\u0643\u0644 \u0627\u0644\u062D\u0627\u0631\u0629
      \u0643\u0644\u0647\u0627."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547319
    m_Localized: "\u062E\u0644\u0651\u0635\u062A\u064A \u0627\u0644\u0634\u0627\u064A\u061F
      \u0647\u0633\u0651\u0639 \u0627\u0639\u0645\u0644\u064A \u0625\u0628\u0631\u064A\u0642\u064A\u0646
      \u064A\u0627 \u0639\u064A\u0648\u0646\u064A\u060C \u0648\u0645\u0627 \u062D\u062F\u0627
      \u064A\u0632\u0639\u0644."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547320
    m_Localized: "\u0627\u0644\u0632\u0639\u0641\u0631\u0627\u0646 \u063A\u0627\u0644\u064A
      \u0645\u062A\u0644 \u0627\u0644\u062F\u0647\u0628. \u062E\u064A\u0637\u064A\u0646
      \u0628\u0633\u060C \u0648\u0627\u0644\u0628\u0627\u0642\u064A \u0644\u0644\u0639\u064A\u062F."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547321
    m_Localized: "\u0647\u064A\u0644 \u0643\u062A\u064A\u0631\u060C \u0643\u062A\u064A\u0631.
      \u0623\u0647\u0644 \u0627\u0644\u0631\u064A\u0627\u0636 \u0643\u0631\u0645\u0627\u060C
      \u0648\u0643\u0631\u0645\u0647\u0645 \u0628\u064A\u0628\u064A\u0651\u0646 \u0628\u0627\u0644\u0647\u064A\u0644."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547322
    m_Localized: "\u0623\u0648\u0644 \u0645\u0631\u0629 \u0634\u0641\u062A\u0647\u0627
      \u0642\u0644\u062A: \u0647\u0627\u064A \u0634\u0627\u064A! \u0648\u0628\u0639\u062F\u064A\u0646
      \u0634\u0631\u0628\u062A \u062A\u0644\u0627\u062A \u0641\u0646\u0627\u062C\u064A\u0646."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547323
    m_Localized: "\u0627\u0644\u0641\u0646\u062C\u0627\u0646 \u0632\u063A\u064A\u0631\u060C
      \u0648\u0628\u062A\u0647\u0632\u0651\u064A\u0647 \u0644\u0645\u0627 \u062A\u0643\u062A\u0641\u064A.
      \u0623\u0646\u0627 \u0639\u0645\u0631\u064A \u0645\u0627 \u0647\u0632\u0651\u064A\u062A\u0647."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547324
    m_Localized: "\u0647\u0627\u0644\u062F\u0644\u0651\u0629 \u0647\u062F\u064A\u0629
      \u0623\u0647\u0644 \u0627\u0644\u0639\u0631\u064A\u0633 \u0628\u0639\u0631\u0633
      \u0646\u0648\u0627\u0644. \u0627\u0644\u062F\u0644\u0651\u0629 \u0636\u0644\u0651\u062A
      \u0647\u0648\u0646\u060C \u0648\u0646\u0648\u0627\u0644 \u0631\u0627\u062D\u062A."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547325
    m_Localized: "\u0627\u0644\u062A\u0645\u0631 \u0642\u0628\u0644 \u0627\u0644\u0642\u0647\u0648\u0629.
      \u0648\u0627\u0644\u0644\u064A \u0628\u064A\u0633\u0623\u0644 \u0644\u064A\u0634\u060C
      \u0628\u064A\u0627\u062E\u062F \u062A\u0645\u0631\u062A\u064A\u0646."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547326
    m_Localized: "\u0635\u064A\u0646\u064A\u0629 \u0645\u0646 \u0627\u0644\u0631\u064A\u0627\u0636
      \u0648\u0641\u0646\u062C\u0627\u0646 \u0645\u0646 \u0639\u0645\u0651\u0627\u0646:
      \u0647\u064A\u0643 \u0639\u0645\u0644\u062A \u0642\u0647\u0648\u0629 \u0639\u0631\u0633
      \u0646\u0648\u0627\u0644."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547327
    m_Localized: "\u0627\u0644\u0645\u062C\u0644\u0633 \u0645\u0627 \u0625\u0644\u0647
      \u0631\u0627\u0633. \u0643\u0644 \u0627\u0644\u0644\u064A \u0628\u064A\u0642\u0639\u062F
      \u0641\u064A\u0647 \u0628\u064A\u0635\u064A\u0631 \u0645\u0646 \u0623\u0647\u0644
      \u0627\u0644\u0628\u064A\u062A."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547328
    m_Localized: "\u0635\u0627\u0631 \u0639\u0646\u062F\u0643 \u0642\u0647\u0648\u062A\u064A\u0646
      \u064A\u0627 \u0631\u0648\u062D\u064A. \u0648\u0627\u0644\u0642\u0644\u0628
      \u0627\u0644\u0648\u0627\u062D\u062F \u0628\u064A\u0633\u0627\u0639 \u0627\u0644\u062A\u0646\u062A\u064A\u0646."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547329
    m_Localized: "\u0627\u0644\u062D\u0644\u064A\u0628 \u0628\u064A\u0641\u0648\u0631
      \u0623\u0648\u0644 \u0645\u0627 \u062A\u063A\u0645\u0651\u0636\u064A \u0639\u064A\u0646\u0643.
      \u0645\u062A\u0644 \u0631\u0646\u0627 \u0648\u0647\u064A \u0632\u063A\u064A\u0631\u0629."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547330
    m_Localized: "\u0627\u0644\u0644\u0628\u0646\u0629 \u0628\u062A\u062A\u0635\u0641\u0651\u0649
      \u0644\u064A\u0644\u0629 \u0643\u0627\u0645\u0644\u0629. \u0627\u0644\u0637\u064A\u0651\u0628
      \u0628\u062F\u0651\u0647 \u0644\u064A\u0644\u060C \u0648\u0627\u0644\u0635\u0628\u062D
      \u0628\u064A\u0628\u064A\u0651\u0646."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547331
    m_Localized: "\u0627\u0644\u062C\u0628\u0646\u0629 \u0627\u0644\u0628\u064A\u0636\u0627
      \u0628\u0627\u0644\u0645\u064A \u0627\u0644\u0645\u0627\u0644\u062D\u0629 \u0628\u062A\u0639\u064A\u0634
      \u0633\u0646\u0629. \u0648\u0627\u0644\u0632\u0639\u0644 \u0628\u064A\u0639\u064A\u0634
      \u0623\u0643\u062A\u0631."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547332
    m_Localized: "\u0627\u0644\u0646\u0627\u0628\u0644\u0633\u064A\u0629 \u0628\u062A\u0646\u0627\u0645
      \u0628\u0627\u0644\u0645\u064A \u0645\u0646 \u0627\u0644\u0644\u064A\u0644.
      \u0627\u0644\u0645\u0627\u0644\u062D \u0628\u064A\u0637\u0644\u0639\u060C \u0648\u0627\u0644\u0637\u064A\u0651\u0628
      \u0628\u064A\u0636\u0644."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547333
    m_Localized: "\u0635\u062D\u0646 \u0627\u0644\u062C\u0628\u0646\u0629 \u0628\u062F\u0651\u0647
      \u0632\u064A\u062A\u0648\u0646\u060C \u0648\u0646\u0639\u0646\u0639\u060C \u0648\u062E\u0628\u0632
      \u0633\u062E\u0646. \u0648\u0627\u0644\u0628\u0627\u0642\u064A \u062D\u0643\u064A."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547334
    m_Localized: "\u0627\u0644\u0641\u0637\u0648\u0631 \u0627\u0644\u0639\u0631\u0628\u064A
      \u0645\u0627 \u0628\u064A\u062E\u0644\u0635. \u0628\u062A\u0642\u0648\u0645\u064A\u060C
      \u0648\u0628\u064A\u0642\u0639\u062F \u062D\u062F\u0627 \u0645\u0637\u0631\u062D\u0643."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547335
    m_Localized: "\u0635\u064A\u0646\u064A\u0629 \u0627\u0644\u062C\u0645\u0639\u0629
      \u0644\u0623\u0628\u0648 \u0641\u0627\u062F\u064A: \u0644\u0628\u0646\u0629
      \u0648\u0632\u0639\u062A\u0631. \u0648\u0645\u0627 \u062D\u062F\u0627 \u064A\u0633\u0623\u0644\u0647
      \u0644\u064A\u0634 \u0633\u0627\u0643\u062A."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547336
    m_Localized: "\u0633\u0641\u0631\u0629 \u0627\u0644\u062C\u0645\u0639\u0629 \u0628\u062F\u0647\u0627
      \u0643\u0644 \u0627\u0644\u0643\u0631\u0627\u0633\u064A. \u0648\u0627\u0644\u0641\u0627\u0636\u064A\u060C
      \u062D\u0637\u0651\u0648\u0627 \u0642\u062F\u0651\u0627\u0645\u0647 \u0641\u0646\u062C\u0627\u0646."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547337
    m_Localized: "\u0627\u0644\u062C\u0645\u0639\u0629 \u0643\u0627\u0646\u062A \u0644\u0644\u0643\u0644.
      \u0631\u062C\u0651\u0639\u064A\u0647\u0645 \u064A\u0627 \u062D\u0628\u064A\u0628\u062A\u064A\u060C
      \u0648\u0627\u062D\u062F \u0648\u0627\u062D\u062F."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547338
    m_Localized: "\u062D\u0641\u0646\u0629 \u0628\u0646 \u0628\u0633 \u064A\u0627
      \u0628\u0646\u062A\u064A\u060C \u0623\u0634\u0645\u0651\u0647\u0627. \u0645\u0646
      \u0632\u0645\u0627\u0646 \u0645\u0627 \u0634\u0645\u0651\u064A\u062A \u0631\u064A\u062D\u0629
      \u0642\u0647\u0648\u062A\u0647\u0627."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547339
    m_Localized: "\u0647\u0627\u064A \u0627\u0644\u0631\u064A\u062D\u0629\u2026 \u0643\u0644
      \u0635\u0628\u062D \u0643\u0627\u0646\u062A \u062A\u0635\u062D\u0651\u064A
      \u0627\u0644\u062D\u0627\u0631\u0629 \u0641\u064A\u0647\u0627."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547340
    m_Localized: "\u0627\u0644\u062C\u064A\u0631\u0627\u0646 \u0637\u0644\u0651\u0648\u0627
      \u0645\u0646 \u0627\u0644\u0634\u0628\u0627\u0628\u064A\u0643. \u0636\u064A\u0651\u0641\u064A\u0647\u0645
      \u064A\u0627 \u0628\u0646\u062A\u064A\u060C \u0648\u0627\u0644\u062D\u0633\u0627\u0628
      \u0639\u0644\u064A\u0651."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547341
    m_Localized: "\u0628\u0643\u0631\u0627 \u0628\u064A\u0631\u062C\u0639\u0648\u0627\u060C
      \u0648\u0628\u064A\u062C\u064A\u0628\u0648\u0627 \u0645\u0639\u0647\u0645 \u0646\u0627\u0633.
      \u0647\u064A\u0643 \u0628\u0644\u0651\u0634\u062A \u0633\u062A\u0651\u0643."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547342
    m_Localized: "\u0628\u0643\u0631\u0627 \u0627\u0644\u0633\u0627\u0639\u0629 \u062E\u0645\u0633\u0629!
      \u0628\u062F\u0651\u064A \u062D\u0644\u0648 \u064A\u0628\u064A\u0651\u0636
      \u0627\u0644\u0648\u062C\u0647\u060C \u0648\u0642\u0647\u0648\u0629 \u0639\u0644\u0649
      \u0623\u0635\u0648\u0644\u0647\u0627."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547343
    m_Localized: "\u0647\u064A\u0643! \u0625\u0630\u0627 \u0645\u0627 \u062D\u0628\u0651\u0643
      \u0627\u0644\u0639\u0631\u064A\u0633\u060C \u0623\u0643\u064A\u062F \u0628\u064A\u062D\u0628
      \u0627\u0644\u0645\u0639\u0645\u0648\u0644."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547344
    m_Localized: "\u0633\u062A\u0651\u0643 \u0643\u0627\u0646\u062A \u062A\u0633\u0643\u0651\u062A\u0646\u064A
      \u0628\u0627\u0644\u0645\u0639\u0645\u0648\u0644. \u062C\u064A\u0628\u064A
      \u062A\u0646\u062A\u064A\u0646\u060C \u0635\u0648\u062A\u064A \u0639\u0627\u0644\u064A."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547345
    m_Localized: "\u062E\u0644\u0635\u060C \u0633\u0643\u062A\u0651. \u062F\u0642\u064A\u0642\u0629
      \u0648\u062D\u062F\u0629\u2026 \u0639\u0634\u0627\u0646 \u062E\u0627\u0637\u0631\u0647\u0627."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547346
    m_Localized: "\u0628\u064A\u0627\u0644\u062A\u064A\u0646 \u0634\u0627\u0647\u064A:
      \u0648\u062D\u062F\u0629 \u0644\u064A\u060C \u0648\u0648\u062D\u062F\u0629
      \u0623\u062B\u0628\u062A \u0644\u0643 \u0641\u064A\u0647\u0627 \u0625\u0646\u0651\u064A
      \u0635\u062D."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547347
    m_Localized: "\u0634\u0641\u062A\u064A\u061F \u0628\u0627\u0644\u0646\u0639\u0646\u0627\u0639
      \u0623\u0637\u064A\u0628. \u0644\u0627 \u062A\u0642\u0648\u0644\u064A\u0646
      \u0634\u064A\u060C \u0648\u062C\u0647\u0643 \u0642\u0627\u0644."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547348
    m_Localized: "\u062D\u0628\u0651\u0629 \u0627\u0644\u0647\u064A\u0644 \u0648\u062D\u0628\u0651\u0629
      \u0627\u0644\u0633\u0643\u0651\u0631\u2026 \u062C\u064A\u0628\u064A\u0644\u064A
