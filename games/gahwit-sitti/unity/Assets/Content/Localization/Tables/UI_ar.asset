      \u0648\u062D\u062F\u0629."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547349
    m_Localized: "\u0647\u064A\u0643 \u0643\u0627\u0646\u062A \u0633\u062A\u0651\u0643\u0645
      \u0628\u062F\u0647\u0627 \u0625\u064A\u0627\u0643\u0645: \u0639\u0635\u064A\u0646\u064A\u0629
      \u0648\u062D\u062F\u0629."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547350
    m_Localized: "\u0642\u0644\u062A\u0648\u0627 \u0635\u062D\u0646\u064A \u0648\u0641\u0646\u062C\u0627\u0646\u064A
      \u0639\u0644\u064A\u0643\u0645\u061F \u0645\u0627\u0634\u064A. \u0627\u0644\u062E\u0634\u0628
      \u0628\u064A\u0634\u062A\u063A\u0644 \u0639\u0627\u0644\u0634\u0628\u0639."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547351
    m_Localized: "\u0627\u0644\u062D\u062C\u0651\u0629 \u0643\u0627\u0646\u062A \u062A\u0637\u0639\u0645\u064A\u0646\u064A
      \u0647\u064A\u0643\u060C \u0648\u0623\u0646\u0627 \u0635\u0628\u064A \u0639\u0646\u062F
      \u0645\u0639\u0644\u0651\u0645\u064A."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547352
    m_Localized: "\u0641\u0646\u062C\u0627\u0646 \u0648\u0627\u062D\u062F \u0645\u0646
      \u0627\u0644\u062F\u0644\u0651\u0629 \u0627\u0644\u0635\u063A\u064A\u0631\u0629.
      \u0648\u0644\u0627 \u062A\u0633\u0623\u0644\u064A\u0646 \u0644\u064A\u0634."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547353
    m_Localized: "\u0643\u0627\u0646\u062A \u0625\u064A\u062F\u0647\u0627 \u062F\u0627\u0641\u064A\u0629
      \u0641\u0648\u0642 \u0625\u064A\u062F\u064A\u2026 \u062E\u0644\u0627\u0635\u060C
      \u0648\u0644\u0627 \u0643\u0644\u0645\u0629."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547354
    m_Localized: "\u0641\u0646\u062C\u0627\u0646 \u0645\u0646 \u062C\u062F\u0651\u0629\u060C
      \u0648\u0641\u0646\u062C\u0627\u0646 \u0645\u0646 \u0639\u0645\u0651\u0627\u0646.
      \u0623\u0646\u0627 \u0645\u0646 \u0627\u0644\u0627\u062A\u0646\u064A\u0646
      \u064A\u0627 \u0628\u0646\u062A\u064A."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547355
    m_Localized: "\u0625\u064A\u0648\u0647\u060C \u0643\u062F\u0627. \u0627\u0644\u0637\u0639\u0645\u064A\u0646
      \u0641\u064A \u0642\u0644\u0628 \u0648\u0627\u062D\u062F\u2026 \u0632\u064A
      \u0632\u0645\u0627\u0646."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547356
    m_Localized: "\u0623\u0645\u0651\u064A \u0633\u0623\u0644\u062A \u0639\u0646
      \u0627\u0644\u0642\u0647\u0648\u0629. \u0633\u0648\u0651\u064A \u062F\u0644\u0651\u0629
      \u0648\u062A\u0645\u0631\u060C \u0623\u0628\u063A\u0649 \u0623\u0635\u0648\u0651\u0631\u0647\u0627
