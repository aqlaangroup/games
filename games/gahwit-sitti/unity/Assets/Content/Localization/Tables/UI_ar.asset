      \u0635\u063A\u064A\u0631\u0629 \u062A\u062D\u062A \u0632\u0631 \u0627\u0644\u064A\u0648\u0645."
    m_Metadata:
      m_Items: []
  - m_Id: 139309578444842
    m_Localized: "\u0633\u0648\u0642 \u0627\u0644\u062C\u0645\u0639\u0629"
    m_Metadata:
      m_Items: []
  - m_Id: 139309578444843
    m_Localized: "\u0641\u064A \u0627\u0644\u0641\u0639\u0627\u0644\u064A\u0627\u062A
      \u0644\u0648\u062D\u0629 \u0635\u063A\u064A\u0631\u0629 \u0628\u0633\u0644\u0633\u0644\u062A\u0647\u0627
      \u0627\u0644\u062E\u0627\u0635\u0629. \u0642\u062F\u0651\u0645\u064A \u0637\u0644\u0628\u0627\u062A\u0647\u0627
      \u0644\u062A\u062C\u0645\u0639\u064A \u0627\u0644\u0631\u0645\u0648\u0632 \u0648\u0627\u0644\u062C\u0648\u0627\u0626\u0632."
    m_Metadata:
      m_Items: []
  - m_Id: 141108913889280
    m_Localized: "\u0646\u0641\u062F\u062A \u0637\u0627\u0642\u062A\u064A\u060C \u0645\u0627\u0630\u0627
      \u0623\u0641\u0639\u0644\u061F"
    m_Metadata:
      m_Items: []
  - m_Id: 141108922277888
    m_Localized: "\u062A\u0645\u062A\u0644\u0626 \u0627\u0644\u0637\u0627\u0642\u0629
      \u0648\u062D\u062F\u0647\u0627 \u0645\u0639 \u0627\u0644\u0648\u0642\u062A.
      \u0648\u0641\u064A \u0627\u0644\u0623\u062B\u0646\u0627\u0621 \u0628\u064A\u0639\u064A
      \u0627\u0644\u0642\u0637\u0639 \u0627\u0644\u062A\u064A \u0644\u0627 \u062A\u062D\u062A\u0627\u062C\u064A\u0646\u0647\u0627\u060C
      \u0648\u0627\u062F\u0645\u062C\u064A \u0645\u0627 \u0639\u0644\u0649 \u0627\u0644\u0644\u0648\u062D\u0629\u060C
      \u0648\u0632\u0648\u0631\u064A \u0627\u0644\u0645\u0642\u0647\u0649."
    m_Metadata:
      m_Items: []
  - m_Id: 141108922277889
    m_Localized: "\u0647\u0644 \u0623\u0633\u062A\u0637\u064A\u0639 \u0627\u0644\u0644\u0639\u0628
