    m_Metadata:
      m_Items: []
  - m_Id: 141108922277890
    m_Localized: "\u0646\u0639\u0645. \u064A\u064F\u062D\u0641\u0638 \u062A\u0642\u062F\u0651\u0645\u0643
      \u0639\u0644\u0649 \u0647\u0627\u062A\u0641\u0643 \u0648\u064A\u064F\u0631\u0641\u0639
      \u0625\u0644\u0649 \u0627\u0644\u0633\u062D\u0627\u0628\u0629 \u0639\u0646\u062F
      \u0639\u0648\u062F\u0629 \u0627\u0644\u0627\u062A\u0635\u0627\u0644. \u0627\u0644\u0641\u0639\u0627\u0644\u064A\u0627\u062A
      \u0648\u0627\u0644\u0645\u062A\u062C\u0631 \u064A\u062D\u062A\u0627\u062C\u0627\u0646
      \u0627\u062A\u0635\u0627\u0644\u064B\u0627."
    m_Metadata:
      m_Items: []
  - m_Id: 141108922277891
    m_Localized: "\u0643\u064A\u0641 \u0623\u063A\u064A\u0651\u0631 \u0627\u0644\u0644\u063A\u0629
