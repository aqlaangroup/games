      m_Items: []
  - m_Id: 399969738547360
    m_Localized: "\u0627\u0644\u062D\u0628\u0642 \u0645\u0627 \u0628\u064A\u064A\u062C\u064A
      \u0644\u062D\u0627\u0644\u0647 \u064A\u0627 \u0628\u0646\u062A\u064A. \u062D\u0637\u0651\u064A
      \u0641\u0646\u062C\u0627\u0646 \u0632\u064A\u0627\u062F\u0629 \u0639\u0627\u0644\u0635\u064A\u0646\u064A\u0629."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547361
    m_Localized: "\u062E\u0644\u0651\u064A \u0627\u0644\u0641\u0646\u062C\u0627\u0646
      \u0627\u0644\u0632\u064A\u0627\u062F\u0629. \u0628\u0643\u0631\u0627 \u0623\u0648
      \u0628\u0639\u062F\u0647\u060C \u0628\u064A\u064A\u062C\u064A \u0645\u064A\u0646
      \u064A\u0634\u0631\u0628\u0647."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547362
    m_Localized: "\u062F\u0648\u0651\u0642\u062A\u0643\u0645 \u0645\u0646 \u0645\u0637\u0628\u062E\u064A\u060C
      \u0647\u0633\u0651\u0627 \u062F\u0648\u0651\u0642\u0648\u0646\u064A \u0645\u0646
      \u0645\u0637\u0628\u062E\u0643\u0645. \u0648\u0644\u0631\u0627\u0645\u064A
      \u0645\u0639\u0645\u0648\u0644."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547363
    m_Localized: "\u0645\u0646 \u064A\u0648\u0645 \u0645\u0627 \u0631\u0627\u062D
      \u0623\u0628\u0648 \u0631\u0627\u0645\u064A\u060C \u0645\u0627 \u062D\u062F\u0627
      \u0637\u0628\u062E\u0644\u064A. \u062A\u0633\u0644\u0645 \u0625\u064A\u062F\u0643\u0645."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547364
    m_Localized: "\u0627\u0644\u064A\u0648\u0645 \u0645\u0627 \u0628\u062D\u0637\u0651
      \u0627\u0644\u0631\u0633\u0627\u064A\u0644 \u0648\u0628\u0645\u0634\u064A.
      \u062C\u064A\u0628\u064A\u0644\u064A \u0625\u0628\u0631\u064A\u0642 \u0643\u0627\u0645\u0644."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547365
    m_Localized: "\u0633\u062A\u0651\u0643 \u0643\u0627\u0646\u062A \u062A\u0635\u0628\u0651\u0644\u064A
      \u0647\u064A\u0643\u060C \u0648\u0623\u0646\u0627 \u062F\u0627\u064A\u0645\u064B\u0627
      \u0645\u0633\u062A\u0639\u062C\u0644. \u0647\u0633\u0651\u0627 \u0645\u0627
      \u0639\u0627\u062F."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547366
    m_Localized: "\u0627\u0644\u0633\u0642\u0641 \u062E\u0644\u0635\u061F \u0627\u0644\u0641\u0637\u0648\u0631
      \u0639\u0644\u064A\u0651. \u0635\u064A\u0646\u064A\u0629 \u0644\u0644\u0645\u0639\u0644\u0651\u0645
      \u0648\u0634\u0628\u0627\u0628 \u0627\u0644\u0648\u0631\u0634\u0629\u060C \u0628\u0644\u064A\u0632."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547367
    m_Localized: "\u0628\u064A\u0631\u0641\u0643\u062A. \u0647\u064A\u0643 \u0643\u0627\u0646\u062A
      \u062A\u0637\u0644\u0639 \u0627\u0644\u0635\u0648\u0627\u0646\u064A \u0632\u0645\u0627\u0646\u2026
      \u0628\u062A\u062E\u064A\u0651\u0644 \u064A\u0639\u0646\u064A."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547368
    m_Localized: "\u0633\u062A\u0651\u064A \u0633\u0648\u0651\u062A \u062F\u064A\u0644\u061F
      \u0633\u0648\u0651\u064A \u0635\u064A\u0646\u064A\u0629 \u0634\u0627\u0647\u064A\u060C
      \u0627\u0644\u0644\u064A\u0644\u0629 \u0637\u0648\u064A\u0644\u0629."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547369
    m_Localized: "\u0632\u064A\u0646. \u0627\u0644\u0644\u064A \u0645\u0627 \u0646\u0639\u0631\u0641\u0647\u060C
      \u0645\u0627 \u0646\u0628\u064A\u0639\u0647."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547370
    m_Localized: "\u0642\u0644\u062A\u0644\u0643\u0645: \u0641\u0646\u062C\u0627\u0646\u064A\u0646\u060C
      \u0648\u062A\u0639\u0627\u0644\u0648\u0627 \u0639\u0627\u0644\u0634\u0628\u0651\u0627\u0643.
      \u0623\u0646\u0627 \u062C\u0627\u0647\u0632."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547371
    m_Localized: "\u0627\u0642\u0639\u062F\u0648\u0627 \u064A\u0627 \u0628\u0646\u0627\u062A.
      \u0639\u0634\u0631\u064A\u0646 \u0633\u0646\u0629 \u0648\u0623\u0646\u0627
      \u0628\u0633\u062A\u0646\u0651\u0649 \u0647\u0627\u0644\u0641\u0646\u062C\u0627\u0646\u064A\u0646."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547372
    m_Localized: "\u0623\u0645\u0651\u064A \u0645\u0627 \u0631\u062F\u0651\u062A.
      \u0633\u0648\u0651\u064A \u062F\u0644\u0651\u0629 \u0639\u0644\u0649 \u0637\u0631\u064A\u0642\u062A\u0647\u0627\u2026
      \u064A\u0645\u0643\u0646 \u062A\u0648\u0635\u0644\u0647\u0627 \u0627\u0644\u0631\u064A\u062D\u0629."
    m_Metadata:
      m_Items: []
  - m_Id: 399969738547373
    m_Localized: "\u0631\u064A\u062D\u062A\u0647\u0627 \u0631\u064A\u062D\u0629 \u0628\u064A\u062A\u0646\u0627
