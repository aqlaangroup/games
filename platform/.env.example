# Aqlaan platform (games) secrets for the s1 deploy. Copy to .env (git-ignored, chmod 600). Values are never committed or printed.
# Comments go on their own lines: the tools read everything after "=" as the value.

# Set by release.sh on every release; 0.0.0 until the first one.
GAMES_VERSION=0.0.0

# Written by ~/Desktop/projects/servers/tools/app_onboard.py during onboarding.
# Leave them empty until then: onboarding keeps a value it finds here.
GAMES_DB_OWNER_PASSWORD=
GAMES_DB_APP_PASSWORD=

# App secrets.
# Auth:SigningKey (32+ bytes). Generate with: openssl rand -base64 48
GAMES_SIGNING_KEY=
